{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "memory": 512
    }
  },
  "engines": {
  "node": "24.x"
}
  "rewrites": [
    {
      "source": "/s/:token/index.m3u8",
      "destination": "/api/stream?sig=:token"
    },
    {
      "source": "/s/:token",
      "destination": "/api/stream?sig=:token"
    },
    {
      "source": "/p/:token",
      "destination": "/api/proxy?tok=:token"
    },
    {
      "source": "/player_api.php",
      "destination": "/api/xtream/player_api.php"
    },
    {
      "source": "/panel_api.php",
      "destination": "/api/xtream/player_api.php"
    },
    {
      "source": "/get.php",
      "destination": "/api/xtream/get.php"
    },
    {
      "source": "/xmltv.php",
      "destination": "/api/xtream/xmltv.php"
    },
    {
      "source": "/live/:user/:pass/:file",
      "destination": "/api/live/:user/:pass/:file"
    },
    {
      "source": "/movie/:user/:pass/:file",
      "destination": "/api/live/:user/:pass/:file"
    },
    {
      "source": "/series/:user/:pass/:file",
      "destination": "/api/live/:user/:pass/:file"
    },
    {
      "source": "/m3u/:token",
      "destination": "/api/playlist?token=:token"
    },
    {
      "source": "/api",
      "destination": "/api/channels"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, Range"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,OPTIONS"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
