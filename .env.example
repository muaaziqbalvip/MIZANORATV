# ─────────────────────────────────────────────────────────────
# Mizanora TV — Environment Variables (Vercel → Project → Settings → Env)
# Ye file .env.example hai. Asli values kabhi GitHub pe push na karein.
# ─────────────────────────────────────────────────────────────

# Firebase Admin (server side) — Firebase Console → Project Settings → Service accounts
# → "Generate new private key" → us JSON ka content EK LINE me (newlines \n nahi, seedha JSON).
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"mizanora-tv-001","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxx@mizanora-tv-001.iam.gserviceaccount.com","client_id":"..."}

# Public Firebase config (frontend bhi inhi se chalta hai, ye safe hai)
FIREBASE_PROJECT_ID=mizanora-tv-001
FIREBASE_API_KEY=AIzaSyBmmTd7mJNv0Iq8QvZKEpIaR_CvkmDvoWk

# Public base URL (Vercel domain) — playlist + stream URLs isi se bante hain
PUBLIC_BASE_URL=https://mizanora-tv.vercel.app

# GitHub master M3U publish (Pat token: repo scope, fine-grained → Contents: Read+Write)
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=muaziqbal/mizanora-tv
GITHUB_BRANCH=main
GITHUB_PATH=data/master.m3u

# Private playlist token — sirf owner ko pata hoga (/m3u/<token>)
PLAYLIST_TOKEN=mizanora-private-9f3a71

# Optional: proxy secret for stream proxy hardening
STREAM_PROXY_SECRET=
